#!/usr/bin/env python3
"""Local search and explicit actions. No shell interpolation, AI or network queries."""
import glob
import shlex
import stat
import shutil
import time
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import unicodedata

HOME = Path.home()
LIMIT = 40

def norm(s):
    return ''.join(c for c in unicodedata.normalize('NFD',str(s)).lower() if not unicodedata.combining(c))

def matches(text, query):
    return all(word in norm(text) for word in norm(query).split())

def run(argv, timeout=2, cap=512*1024):
    # A temporary file keeps child output out of the long-running shell process.
    with tempfile.TemporaryFile() as out:
        try:
            p=subprocess.run(argv,stdout=out,stderr=subprocess.DEVNULL,timeout=timeout,check=False)
            if p.returncode: return ''
        except (OSError,subprocess.TimeoutExpired): return ''
        out.seek(0)
        return out.read(cap).decode('utf-8','replace')

def row(kind, ident, name, subtext, **data):
    return dict(kind=kind,id=kind+':'+ident,name=name,subtext=subtext,iconUrl='',monogram='',isNew=False,**data)

def history():
    path=HOME/'.local/state/omarchy/clipboard-history.json'
    try:
        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
        with os.fdopen(fd,'rb') as f:
            import stat
            st=os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_size>8*1024*1024: return []
            data=json.loads(f.read(8*1024*1024+1))
        return [x['text'] for x in data[:200] if isinstance(x,dict) and x.get('type')=='text' and isinstance(x.get('text'),str) and x['text'].strip()] if isinstance(data,list) else []
    except (OSError,ValueError): return []

def digest(text):return hashlib.sha256(text.encode()).hexdigest()

def files(query):
    query=query.strip()
    if not query:return []
    base=str(HOME)
    pattern=query
    if query.startswith(('~/','/')):
        path=Path(os.path.expanduser(query))
        if path.is_dir():base=str(path);pattern=''
        else:base=str(path.parent);pattern=path.name
    terms=pattern.split()[:8] or ['']
    argv=['fd','--ignore-case','--color','never','--print0','--max-results','80',
          '--exclude','.git','--exclude','node_modules','--exclude','.cache']
    for t in terms[1:]:argv+=['--and',re.escape(t)]
    argv+=['--',re.escape(terms[0]),base]
    paths=[p for p in run(argv,timeout=2).split('\0') if p]
    paths.sort(key=lambda p:(norm(Path(p).name)!=norm(pattern),len(Path(p).parts),norm(p)))
    return [row('file',p,Path(p).name,str(Path(p).parent),path=p,
                icon='folder' if Path(p).is_dir() else 'text-x-generic') for p in paths[:LIMIT]]

def windows(query):
    try: data=json.loads(run(['hyprctl','clients','-j']))
    except ValueError:return []
    return [row('window',w['address'],w.get('title') or w.get('class') or 'Janela',
                'Janela · '+str(w.get('class',''))+' · área '+str(w.get('workspace',{}).get('name','')),
                address=w['address'],icon='preferences-system-windows')
            for w in data if w.get('address') and matches(str(w.get('title',''))+' '+str(w.get('class','')),query)][:LIMIT]

def clipboard(query):
    rows=[];seen=set()
    for text in history():
        key=digest(text)
        if key in seen or not matches(text,query):continue
        seen.add(key)
        title=' '.join(text.split())[:140]
        rows.append(row('clipboard',key,title,'Histórico de cópia · Enter copia novamente',hash=key,icon='edit-paste'))
        if len(rows)>=LIMIT:break
    return rows

def ssh_hosts(query):
    """Read explicit aliases without running ssh -G, Match exec or ProxyCommand."""
    hosts=[]; seen=set(); visited=set(); budget=[2*1024*1024]
    alias_re=re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.:@%-]{0,254}\Z")

    def add(alias, source, port=None):
        if not alias_re.fullmatch(alias):return
        key=(alias.lower(),port)
        if key in seen or len(hosts)>=300:return
        seen.add(key)
        argv=['ssh'] + (['-p',str(port)] if port else []) + ['--',alias]
        display=alias + (':'+str(port) if port else '')
        hosts.append(row('ssh',display,display,'SSH · '+source+' · Enter conecta; Shift+Enter copia',
                         sshArgs=argv,copyText=shlex.join(argv),icon='utilities-terminal'))

    def read(path, cap):
        try:
            fd=os.open(path,os.O_RDONLY|os.O_NONBLOCK)
            with os.fdopen(fd,'rb') as f:
                if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):return ''
                if budget[0]<=0:return ''
                raw=f.read(min(cap,budget[0])+1)
                budget[0]-=len(raw)
                if len(raw)>cap or budget[0]<0:return ''
                return raw.decode('utf-8','replace')
        except OSError:return ''

    def scan(path, depth=0):
        if depth>8 or len(visited)>=64:return
        path=Path(path).expanduser()
        try:key=str(path.resolve())
        except (OSError,RuntimeError):return
        if key in visited:return
        visited.add(key)
        for line in read(path,256*1024).splitlines():
            directive=re.match(r'^\s*(Host|Include)(?:\s*=\s*|\s+)(.*)$',line,re.I)
            if not directive:continue
            try:values=shlex.split(directive[2],comments=True)
            except ValueError:continue
            if directive[1].lower()=='host':
                for alias in values:add(alias,'config')
            else:
                # OpenSSH resolves relative user Include paths against ~/.ssh.
                # Only enumerate declarations; conditional Include entries may
                # appear even when their surrounding Match is inactive.
                for pattern in values[:64]:
                    if pattern.startswith('~/'):pattern=str(HOME/pattern[2:])
                    elif not os.path.isabs(pattern):pattern=str(HOME/'.ssh'/pattern)
                    import itertools
                    for included in itertools.islice(glob.iglob(pattern),64):scan(included,depth+1)

    scan(HOME/'.ssh/config')
    for line in read(HOME/'.ssh/known_hosts',1024*1024).splitlines():
        parts=line.split()
        if len(parts)<3 or parts[0].startswith(('#','@','|')):continue
        for host in parts[0].split(','):
            endpoint=re.fullmatch(r'\[([^]]+)\]:(\d+)',host)
            if endpoint:
                port=int(endpoint[2])
                if 0<port<65536:add(endpoint[1],'known_hosts',port)
            else:add(host,'known_hosts')
    return [h for h in hosts if matches(h['name'],query)][:LIMIT]

def search(query):
    q=query.strip()[:512]
    mode='all';term=q
    m=re.match(r'^(f|file|arquivo|w|window|janela|cb|clip|copiado|ssh)[: ]\s*(.*)$',q,re.I)
    if m:
        mode={'f':'file','file':'file','arquivo':'file','w':'window','window':'window','janela':'window',
              'cb':'clipboard','clip':'clipboard','copiado':'clipboard','ssh':'ssh'}[m[1].lower()];term=m[2]
    elif q.startswith(('~/','/')):mode='file'
    errors=[];results=[]
    if mode=='file':results=files(term)
    elif mode=='window':results=windows(term)
    elif mode=='clipboard':results=clipboard(term)
    elif mode=='ssh':results=ssh_hosts(term)
    elif len(q)>=2:
        results=windows(q)[:8]+files(q)[:10]
    if mode=='ssh' and not results:errors.append('Nenhum host SSH encontrado no config, Includes ou known_hosts')
    if mode=='file' and not term.strip():errors.append('Digite f e o nome do arquivo; exemplo: f contrato')
    return dict(rows=results[:LIMIT],message=' · '.join(errors))

def removal_risks(package, affected, required_by='', simulation_ok=True):
    important=re.compile(r'^(?:omarchy(?:-|$)|hypr|quickshell|uwsm$|systemd|linux(?:-|$)|base$|base-devel$|glibc$|pacman$|sudo$|networkmanager$|network-manager|iwd$|bluez|pipewire|wireplumber|polkit|xdg-desktop-portal|xdg-terminal-exec|mesa$|nvidia|intel-ucode|amd-ucode|grub$|limine$|openssh$|nautilus$|foot$|alacritty$|kitty$|ghostty$)')
    reasons=[]
    critical=[p for p in affected if important.match(p)]
    if important.match(package) or critical:
        reasons.append('Não é recomendável remover componentes usados pelo desktop, terminal, rede ou sistema: '+', '.join((critical or [package])[:5])+'.')
    if required_by and required_by != 'None':
        reasons.append('Outros pacotes dependem dele: '+required_by[:180]+'. A remoção poderá ser bloqueada pelo gerenciador.')
    if not simulation_ok:
        reasons.append('Não foi possível validar a transação de remoção. Confira os avisos no terminal antes de prosseguir.')
    if len(affected)>8:reasons.append('A operação envolve '+str(len(affected))+' pacotes, incluindo dependências.')
    return reasons

def inspect_package(package):
    # -n only controls backup files and cannot be combined with --print.
    # -Rs prints the same dependency transaction without removing anything.
    affected=run(['pacman','-Rs','--print','--print-format','%n','--',package],timeout=4).strip().splitlines()
    affected=[p for p in affected if re.fullmatch(r'[a-zA-Z0-9@_+.-]+',p)]
    info=run(['env','LC_ALL=C','pacman','-Qi',package])
    match=re.search(r'^Required By\s*:\s*(.*)$',info,re.M)
    required=match[1].strip() if match else ''
    reasons=removal_risks(package,affected,required,bool(affected))
    summary='Será desinstalado o pacote '+package+' pelo gerenciador do sistema.'
    if len(affected)>1:summary+='\nA transação também inclui: '+', '.join(affected[:6])+('…' if len(affected)>6 else '')+'.'
    summary+='\nO terminal mostrará a transação e poderá pedir sua senha.'
    return {'canRemove':True,'summary':summary,'risky':bool(reasons),'reasons':reasons,'package':package,'affected':affected}

def inspect_removal(desktop_id):
    if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.+ -]{0,254}',desktop_id) or '..' in desktop_id:
        return {'canRemove':False,'summary':'Identificador de aplicativo não suportado.'}
    filename=desktop_id if desktop_id.endswith('.desktop') else desktop_id+'.desktop'
    user=Path(os.environ.get('XDG_DATA_HOME') or HOME/'.local/share')/'applications'
    system=[Path(d)/'applications' for d in (os.environ.get('XDG_DATA_DIRS') or '/usr/local/share:/usr/share').split(':') if d]
    path=next((d/filename for d in [user]+system if (d/filename).is_file()),None)
    if path is None:return {'canRemove':False,'summary':'O atalho já não existe. Atualize a busca.'}
    try:
        with path.open('rb') as f:raw=f.read(256*1024).decode('utf-8','replace')
    except OSError:return {'canRemove':False,'summary':'Não foi possível consultar o atalho.'}
    exec_line=next((line[5:] for line in raw.splitlines() if line.startswith('Exec=')),'')
    if re.search(r'omarchy-launch-webapp|omarchy-webapp-handler',exec_line):
        return {'canRemove':True,'summary':'Será removido o web app e seus atalhos locais. O navegador permanece instalado.','risky':False,'reasons':[]}
    if path.parent==user:
        return {'canRemove':True,'summary':'Será removido o atalho local do launcher. O programa em si permanece instalado.','risky':False,'reasons':[]}
    package=run(['pacman','-Qqo',str(path)]).strip().splitlines()
    if package:
        package=package[0]
        if not re.fullmatch(r'[a-zA-Z0-9@_+.-]+',package):return {'canRemove':False,'summary':'Pacote não identificado.'}
        return inspect_package(package)
    flatpak_id=filename[:-8]
    if run(['flatpak','info',flatpak_id]):
        return {'canRemove':True,'summary':'Será desinstalado o Flatpak '+flatpak_id+'. O terminal mostrará a transação.','risky':False,'reasons':[]}
    return {'canRemove':False,'summary':'Não foi possível identificar como remover este aplicativo. Nenhuma alteração foi feita.'}

def inspect_agent(binary):
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.+-]{0,100}',binary):
        return {'canRemove':False,'summary':'O comando deste agente não é um nome de programa suportado.'}
    path=shutil.which(binary)
    if not path:return {'canRemove':False,'summary':'O executável do agente já não está no PATH.'}
    package=run(['pacman','-Qqo',str(Path(path).resolve())]).strip().splitlines()
    if package and re.fullmatch(r'[A-Za-z0-9@_+.-]+',package[0]):
        plan=inspect_package(package[0]);plan.update(strategy='pacman',binary=binary)
        return plan
    wrapper=None;tool=binary
    candidate=Path(path)
    try:
        if candidate.parent==HOME/'.local/bin' and not candidate.is_symlink() and candidate.stat().st_size<4096:
            raw=candidate.read_text()
            match=re.search(r'mise use[^\n]*["\']([A-Za-z0-9_@:/.-]+)["\']',raw)
            if match and 'exec mise ' in raw:wrapper=candidate;tool=match[1]
    except (OSError,UnicodeError):pass
    try: versions=json.loads(run(['mise','ls','--json',tool]))
    except ValueError:versions=[]
    active=[v for v in versions if v.get('installed') and v.get('active')] if isinstance(versions,list) else []
    global_config=HOME/'.config/mise/config.toml'
    managed=any(v.get('source',{}).get('path')==str(global_config) for v in active)
    if managed and (wrapper or '/mise/' in path):
        return {'canRemove':True,'strategy':'mise','tool':tool,'binary':binary,'wrapper':str(wrapper) if wrapper else '',
            'summary':'Será removida a configuração global de '+tool+' no mise e desinstaladas as versões que não forem usadas por outros projetos. O atalho que reinstala automaticamente será desativado, se existir. Seus dados e sessões serão preservados.',
            'risky':True,'reasons':['Este agente é uma ferramenta global. Projetos que dependem dessa configuração podem deixar de encontrá-lo. Versões referenciadas por outros projetos serão preservadas.']}
    return {'canRemove':False,'summary':'A instalação deste agente não foi identificada com segurança (mise global ou pacote do sistema). Nenhum arquivo foi apagado. Comando: '+binary}

def uninstall_agent(binary):
    # Called only from the visible terminal after the UI confirmations.
    plan=inspect_agent(binary)
    if plan.get('canRemove') is not True:raise ValueError(plan.get('summary','Instalação não identificada'))
    print(plan['summary'],flush=True)
    if plan['strategy']=='pacman':
        subprocess.run(['sudo','pacman','-Rns',plan['package']],check=True)
    elif plan['strategy']=='mise':
        backup=HOME/'.local/state/omarchy/launcher-plus/agent-removal-backups'/str(time.time_ns())
        backup.mkdir(parents=True,exist_ok=False)
        config=HOME/'.config/mise/config.toml'
        if config.is_file():shutil.copy2(config,backup/'mise-config.toml')
        subprocess.run(['mise','unuse','--global',plan['tool']],check=True)
        if plan.get('wrapper'):
            wrapper=Path(plan['wrapper'])
            if wrapper.is_file() and not wrapper.is_symlink():shutil.move(str(wrapper),str(backup/(binary+'.wrapper')))
        subprocess.run(['mise','reshim'],check=True)
        print('Backup da configuração/atalho: '+str(backup),flush=True)
    print('Remoção concluída. Feche e abra o launcher para atualizar a lista.',flush=True)

def focus_window(address):
    if not re.fullmatch(r'0x[0-9a-fA-F]+',address):raise ValueError('Identificador de janela inválido')
    # Let the launcher release its exclusive keyboard focus first.
    time.sleep(0.12)
    try: clients=json.loads(run(['hyprctl','clients','-j']))
    except ValueError:raise ValueError('Não foi possível consultar as janelas')
    if not any(w.get('address')==address for w in clients):raise ValueError('Esta janela já foi fechada')
    expression='hl.dsp.focus({ window = "address:'+address+'" })'
    result=subprocess.run(['hyprctl','dispatch',expression],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=3)
    if result.returncode:
        subprocess.run(['hyprctl','dispatch','focuswindow','address:'+address],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=3)

def copy_text(text):
    p=subprocess.run(['wl-copy'],input=text.encode(),stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=4)
    if p.returncode:raise ValueError('Não foi possível copiar')

def action(args):
    if args[0]=='copy':copy_text(args[1])
    elif args[0]=='clipboard':
        text=next((t for t in history() if digest(t)==args[1]),None)
        if text is None:raise ValueError('O item já saiu do histórico; busque novamente')
        copy_text(text)
    else:raise ValueError('Ação desconhecida')

if __name__=='__main__':
    try:
        if sys.argv[1]=='search': result=search(sys.argv[2])
        elif sys.argv[1]=='focus-window': focus_window(sys.argv[2]);result={'ok':True}
        elif sys.argv[1]=='inspect-agent': result=inspect_agent(sys.argv[2])
        elif sys.argv[1]=='uninstall-agent':
            uninstall_agent(sys.argv[2]);result={'ok':True}
            input('Pressione Enter para fechar…')
        elif sys.argv[1]=='inspect-removal': result=inspect_removal(sys.argv[2])
        elif sys.argv[1]=='action': action(sys.argv[2:]);result={'ok':True}
        else:raise ValueError('Comando desconhecido')
    except Exception as e:
        result={'rows':[],'message':'Busca indisponível: '+str(e),'ok':False}
        if len(sys.argv)>1 and sys.argv[1] in ['action','focus-window']:
            run(['notify-send','Launcher Plus',str(e)])
    print(json.dumps(result,ensure_ascii=False))
